using System;
using System.Collections.Generic;
using System.IO;

class Result
{
    /*
     * Complete the 'sockMerchant' function below.
     *
     * The function is expected to return an INTEGER.
     * The function accepts following parameters:
     *  1. INTEGER n
     *  2. INTEGER_ARRAY ar
     */
    public static int sockMerchant(int n, List<int> ar)
    {
        int pairs = 0;
        int[] counts = new int[101];

        foreach (int color in ar)
        {
            counts[color]++;
            
            if (counts[color] % 2 == 0)
            {
                pairs++;
            }
        }

        return pairs;
    }
}

class Solution
{
    public static void Main(string[] args)
    {
        // Smart output selection: to file for HackerRank, to console for local testing
        string outputPath = Environment.GetEnvironmentVariable("OUTPUT_PATH");
        TextWriter textWriter;
        
        if (!string.IsNullOrEmpty(outputPath))
        {
            textWriter = new StreamWriter(outputPath, true);
        }
        else
        {
            textWriter = Console.Out;
        }

        // Read input data
        string nInput = Console.ReadLine();
        if (nInput == null) return;
        int n = Convert.ToInt32(nInput.Trim());

        List<int> ar = new List<int>();
        string arLine = Console.ReadLine();
        
        if (arLine != null)
        {
            string[] arTokens = arLine.TrimEnd().Split(' ');
            foreach (string s in arTokens)
            {
                if (!string.IsNullOrEmpty(s))
                {
                    ar.Add(Convert.ToInt32(s));
                }
            }
        }

        // Call logic
        int result = Result.sockMerchant(n, ar);

        // Print result
        textWriter.WriteLine(result);

        textWriter.Flush();
        
        // Close file only if we are on HackerRank
        if (!string.IsNullOrEmpty(outputPath))
        {
            textWriter.Close();
        }
    }
}
